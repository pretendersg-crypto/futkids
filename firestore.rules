rules_version = '2';

// Regras do Firestore do FutKids (ARQUITETURA_CONTAS.md).
//  Fase 1: famílias, atletas e aparelhos da criança.  Fase 2: escolinhas, turmas e treinadores.
//  - usuarios/{uid}: só o próprio usuário.
//  - familias/{f}: só os responsáveis (pai/mãe). O 2º responsável entra com um convite.
//  - atletas/{a}: a família dele e os aparelhos ligados a ele; o treinador da escolinha SÓ LÊ, e só
//    depois que a família autorizou (LGPD: dado de criança só com o consentimento do responsável).
//  - escolinhas/{e}: os treinadores dela. Plano da turma: qualquer logado lê (não tem dado pessoal;
//    os ids são longos e aleatórios). Membros da turma: os treinadores e a família de cada um.
//  - convites/{código} e codigosTurma/{código}: quem sabe o código lê aquele documento.
//  - "plano", "limites", validade e assinatura (gratuito/pago) só o servidor muda (Cloud Functions);
//    pagamentos/ e pagamentosAplicados/ são só do servidor (nenhuma regra libera o app).
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }
    // Responsável/treinador = login com Google ou e-mail (não o aparelho anônimo da criança)
    function adulto() {
      return logado() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function responsavelDe(f) {
      return adulto() && f != null && request.auth.uid in get(/databases/$(database)/documents/familias/$(f)).data.responsaveis;
    }
    function aparelhoDaFamilia(f) {
      return logado() && exists(/databases/$(database)/documents/familias/$(f)/aparelhos/$(request.auth.uid));
    }
    function atleta(a) {
      return get(/databases/$(database)/documents/atletas/$(a)).data;
    }
    function familiaDoAtleta(a) {
      return atleta(a).familia;
    }
    function aparelhoDoAtleta(a) {
      return logado() && exists(/databases/$(database)/documents/atletas/$(a)/aparelhos/$(request.auth.uid));
    }
    function podeAtleta(a) {
      return responsavelDe(familiaDoAtleta(a)) || aparelhoDoAtleta(a);
    }
    function treinadorDe(e) {
      return adulto() && e != null && request.auth.uid in get(/databases/$(database)/documents/escolinhas/$(e)).data.treinadores;
    }
    // Treinador da escolinha do atleta, depois que a família autorizou
    function treinadorAutorizado(a) {
      let at = atleta(a);
      return at.get('escolinha', null) != null && at.get('autorizacao', null) != null && treinadorDe(at.escolinha);
    }
    // Convite ainda válido, do tipo pedido, livre ou já reservado por quem está usando
    function convite(c) {
      return get(/databases/$(database)/documents/convites/$(c)).data;
    }
    function conviteValido(c, tipo) {
      return exists(/databases/$(database)/documents/convites/$(c))
        && convite(c).tipo == tipo
        && convite(c).expiraEm > request.time
        && (convite(c).usadoPor == null || convite(c).usadoPor == request.auth.uid);
    }
    // Código da turma (para a família entrar), ainda ativo
    function codigoTurmaValido(c, e, t) {
      let ct = get(/databases/$(database)/documents/codigosTurma/$(c)).data;
      return exists(/databases/$(database)/documents/codigosTurma/$(c)) && ct.ativo == true && ct.escolinha == e && ct.turma == t;
    }
    // Dado sincronizado: { json, em, app } (app = versão do formato dos dados do app que gravou)
    function dadoValido() {
      return request.resource.data.keys().hasOnly(['json', 'em', 'app'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000
        && request.resource.data.em is number
        && (!('app' in request.resource.data) || request.resource.data.app is int);
    }
    // Campos da cobrança: só o servidor (Cloud Functions) grava
    function camposDoServidor() {
      return ['plano', 'limites', 'validoAte', 'renovacaoAutomatica', 'assinatura', 'contagem'];
    }
    function semPlanoNovo() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposDoServidor());
    }
    function semCamposDoServidorNaCriacao() {
      return !request.resource.data.keys().hasAny(['validoAte', 'renovacaoAutomatica', 'assinatura', 'contagem']);
    }

    // ---------- usuários ----------
    match /usuarios/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    // ---------- famílias ----------
    match /familias/{f} {
      allow get: if responsavelDe(f) || aparelhoDaFamilia(f);
      // Nova família: eu como único responsável e no plano grátis
      allow create: if adulto()
        && request.resource.data.responsaveis == [request.auth.uid]
        && request.resource.data.plano == 'gratis'
        && semCamposDoServidorNaCriacao();
      // Responsável muda a família (lista de atletas etc.), sem mexer no plano, e pode sair dela
      allow update: if responsavelDe(f) && semPlanoNovo()
        && (request.resource.data.responsaveis == resource.data.responsaveis
            || request.resource.data.responsaveis == resource.data.responsaveis.removeAll([request.auth.uid]));
      // 2º responsável entra com convite: só se acrescenta à lista
      allow update: if adulto() && !(request.auth.uid in resource.data.responsaveis)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responsaveis', 'conviteEntrada'])
        && request.resource.data.responsaveis == resource.data.responsaveis.concat([request.auth.uid])
        && conviteValido(request.resource.data.conviteEntrada, 'responsavel')
        && convite(request.resource.data.conviteEntrada).familia == f;
      allow delete: if responsavelDe(f);

      match /dados/{chave} {
        allow read, delete: if responsavelDe(f) || aparelhoDaFamilia(f);
        allow create, update: if (responsavelDe(f) || aparelhoDaFamilia(f)) && dadoValido();
      }

      // Aparelhos de criança ligados à família (para lerem a biblioteca da família)
      match /aparelhos/{dev} {
        allow get, delete: if responsavelDe(f) || (logado() && request.auth.uid == dev);
        allow list: if responsavelDe(f);
        allow create: if logado() && request.auth.uid == dev
          && conviteValido(request.resource.data.convite, 'aparelho')
          && convite(request.resource.data.convite).familia == f;
      }
    }

    // ---------- atletas ----------
    match /atletas/{a} {
      allow get: if podeAtleta(a) || treinadorAutorizado(a);
      // Atleta novo da família: só apelido, ainda sem escolinha
      allow create: if responsavelDe(request.resource.data.familia)
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.apelido is string
        && request.resource.data.apelido.size() <= 40
        && request.resource.data.turmas == [];
      // A família muda o atleta: apelido, e entrar/sair de uma escolinha (com a autorização)
      allow update: if responsavelDe(resource.data.familia)
        && request.resource.data.familia == resource.data.familia
        && request.resource.data.apelido.size() <= 40;
      allow delete: if responsavelDe(resource.data.familia);

      match /dados/{chave} {
        allow read: if podeAtleta(a) || treinadorAutorizado(a);
        allow delete: if podeAtleta(a);
        allow create, update: if podeAtleta(a) && dadoValido();
      }

      match /aparelhos/{dev} {
        allow get: if podeAtleta(a);
        allow list: if responsavelDe(familiaDoAtleta(a));
        allow delete: if responsavelDe(familiaDoAtleta(a)) || (logado() && request.auth.uid == dev);
        allow create: if logado() && request.auth.uid == dev
          && conviteValido(request.resource.data.convite, 'aparelho')
          && convite(request.resource.data.convite).atleta == a;
      }
    }

    // ---------- escolinhas ----------
    match /escolinhas/{e} {
      allow get: if treinadorDe(e);
      // Nova escolinha: eu como dono e único treinador, no plano grátis e com os limites dele
      allow create: if adulto()
        && request.resource.data.donos == [request.auth.uid]
        && request.resource.data.treinadores == [request.auth.uid]
        && request.resource.data.turmas == {}
        && request.resource.data.plano == 'gratis'
        && request.resource.data.limites == { 'treinadores': 1, 'turmas': 1, 'atletas': 20 }
        && semCamposDoServidorNaCriacao();
      // Treinador muda a escolinha (nome, turmas dentro do limite) e pode sair dela
      allow update: if treinadorDe(e) && semPlanoNovo()
        && request.resource.data.donos == resource.data.donos
        && request.resource.data.turmas.size() <= resource.data.limites.turmas
        && (request.resource.data.treinadores == resource.data.treinadores
            || request.resource.data.treinadores == resource.data.treinadores.removeAll([request.auth.uid])
            // o dono pode tirar outro treinador
            || (request.auth.uid in resource.data.donos
                && request.resource.data.treinadores.size() == resource.data.treinadores.size() - 1
                && request.auth.uid in request.resource.data.treinadores));
      // Novo treinador entra com convite, dentro do limite do plano
      allow update: if adulto() && !(request.auth.uid in resource.data.treinadores)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['treinadores', 'conviteEntrada'])
        && request.resource.data.treinadores == resource.data.treinadores.concat([request.auth.uid])
        && request.resource.data.treinadores.size() <= resource.data.limites.treinadores
        && conviteValido(request.resource.data.conviteEntrada, 'treinador')
        && convite(request.resource.data.conviteEntrada).escolinha == e;
      allow delete: if adulto() && request.auth.uid in resource.data.donos;

      match /turmas/{t} {
        allow read: if logado();
        allow write: if treinadorDe(e);

        // Plano da turma: os treinadores montam; a criança, a família e quem tem o link leem
        match /plano/{p} {
          allow read: if logado();
          allow write: if treinadorDe(e) && request.resource.data.dias is map && request.resource.data.em is number;
        }

        // Plano individual de um atleta da turma (além do plano da turma): o treinador monta; a família
        // e o aparelho do atleta leem. Só para atleta já autorizado (que está nos membros com o id dele)
        match /individuais/{a} {
          allow read: if treinadorDe(e) || podeAtleta(a);
          allow delete: if treinadorDe(e);
          allow create, update: if treinadorDe(e)
            && exists(/databases/$(database)/documents/escolinhas/$(e)/turmas/$(t)/membros/$(a))
            && request.resource.data.dias is map
            && request.resource.data.em is number;
        }

        // Atletas da turma. Id = id do atleta (já autorizado pela família) ou o código do convite
        // (atleta cadastrado pelo treinador, esperando a família aceitar: só o apelido)
        match /membros/{m} {
          allow get, list: if treinadorDe(e)
            || (resource.data.familia != null && responsavelDe(resource.data.familia));
          // Treinador cadastra e convida: só o apelido, sem família e sem autorização
          allow create: if treinadorDe(e)
            && request.resource.data.familia == null
            && request.resource.data.atleta == null
            && request.resource.data.autorizado == false
            && request.resource.data.apelido is string
            && request.resource.data.apelido.size() <= 40
            && conviteValido(m, 'atleta') && convite(m).turma == t;
          // Família põe o atleta dela na turma (autorizando), com o convite do treinador ou o código da turma
          allow create: if responsavelDe(request.resource.data.familia)
            && request.resource.data.atleta == m
            && familiaDoAtleta(m) == request.resource.data.familia
            && request.resource.data.autorizado == true
            && (codigoTurmaValido(request.resource.data.codigo, e, t)
                || (conviteValido(request.resource.data.codigo, 'atleta') && convite(request.resource.data.codigo).turma == t));
          allow delete: if treinadorDe(e)
            || (resource.data.familia != null && responsavelDe(resource.data.familia))
            // a família, ao aceitar o convite, apaga o cadastro provisório do treinador
            || (adulto() && resource.data.familia == null && conviteValido(m, 'atleta'));
        }
      }
    }

    // Código da turma (vários usos): a família digita para entrar na turma
    match /codigosTurma/{c} {
      allow get: if adulto();
      allow create: if treinadorDe(request.resource.data.escolinha)
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.ativo == true;
      allow update, delete: if treinadorDe(resource.data.escolinha);
    }

    // ---------- convites (uso único, com validade) ----------
    match /convites/{c} {
      // Quem tem o código lê aquele convite (não dá para listar os convites)
      allow get: if logado();
      // Da família: ligar o aparelho da criança (24 h) ou chamar o outro responsável (7 dias)
      allow create: if responsavelDe(request.resource.data.familia)
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.tipo in ['aparelho', 'responsavel']
        && request.resource.data.usadoPor == null
        && request.resource.data.expiraEm <= request.time + duration.value(7, 'd')
        && (request.resource.data.tipo != 'aparelho'
            || familiaDoAtleta(request.resource.data.atleta) == request.resource.data.familia);
      // Da escolinha: chamar outro treinador (7 dias) ou convidar a família de um atleta (30 dias)
      allow create: if treinadorDe(request.resource.data.escolinha)
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.tipo in ['treinador', 'atleta']
        && request.resource.data.usadoPor == null
        && request.resource.data.expiraEm <= request.time + duration.value(30, 'd');
      // Reservar o convite para si (uso único)
      allow update: if logado()
        && resource.data.usadoPor == null
        && resource.data.expiraEm > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usadoPor', 'usadoEm'])
        && request.resource.data.usadoPor == request.auth.uid;
      allow delete: if logado() && resource.data.criadoPor == request.auth.uid;
    }
  }
}
